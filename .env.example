# Copy this file to .env.local (never commit .env.local).
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any password you choose. You type the same passcode in the site's "🤖 AI" settings.
APP_PASSCODE=
# Optional: which Gemini model to use
GEMINI_MODEL=gemini-2.5-flash
# Optional: set to 1 to test the screens without calling Gemini
MOCK_AI=0
